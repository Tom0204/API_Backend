# Copier ce fichier en .env (jamais commité), puis choisir un mot de passe PostgreSQL.

# Environnement : development | test | production
NODE_ENV=development
# Port HTTP de l'API
PORT=4001
# Niveau des logs Pino : fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Origines CORS autorisées, séparées par des virgules. Vide : aucune origine externe.
CORS_ORIGINS=

# --- PostgreSQL (lu par docker-compose.yml) ---
POSTGRES_USER=mmorpg
POSTGRES_PASSWORD=change-me
# Port publié sur la machine hôte
POSTGRES_PORT=5432

# Base de développement (obligatoire hors tests). Même utilisateur, mot de passe et port que ci-dessus.
DATABASE_URL=postgresql://mmorpg:change-me@localhost:5432/mmorpg_dev
# Premier administrateur créé par `npm run db:seed` (facultatif ; les deux ensemble ou aucun).
# Mot de passe de 15 à 128 caractères. Un compte existant n'est jamais modifié.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Base des tests PostgreSQL (npm run test:db) : doit viser exactement mmorpg_test, toute autre base est refusée.
TEST_DATABASE_URL=postgresql://mmorpg:change-me@localhost:5432/mmorpg_test
