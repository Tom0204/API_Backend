{
  "info": {
    "name": "API MMORPG",
    "description": "Parcours de l'API (Backlog.md §1), complété à chaque lot. L1 : santé, inscription, connexion, compte courant. Lancer le dossier dans l'ordre avec le Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4001" },
    { "key": "email", "value": "" },
    { "key": "password", "value": "correct-horse-battery-staple" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "L1 — Socle et identité",
      "item": [
        {
          "name": "Santé du service",
          "request": { "method": "GET", "url": "{{baseUrl}}/health" },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 UP', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().data.status).to.eql('UP');",
                  "});",
                  "pm.test('X-Request-Id renvoyé', () => pm.response.to.have.header('X-Request-Id'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Inscription",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": ["pm.collectionVariables.set('email', `player.${Date.now()}.l1@example.com`);"]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201, ni mot de passe ni hash', () => {",
                  "    pm.response.to.have.status(201);",
                  "    const data = pm.response.json().data;",
                  "    pm.expect(Object.keys(data)).to.have.members(['id', 'email', 'createdAt']);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Inscription — email déjà utilisé (409)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('409 EMAIL_ALREADY_USED', () => {",
                  "    pm.response.to.have.status(409);",
                  "    pm.expect(pm.response.json().error.code).to.eql('EMAIL_ALREADY_USED');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Connexion",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200, jeton Bearer', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().data.tokenType).to.eql('Bearer');",
                  "});",
                  "pm.collectionVariables.set('token', pm.response.json().data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Connexion — mauvais mot de passe (401)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"wrong-password\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401 INVALID_CREDENTIALS', () => {",
                  "    pm.response.to.have.status(401);",
                  "    pm.expect(pm.response.json().error.code).to.eql('INVALID_CREDENTIALS');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Mon compte",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/auth/me",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200, compte du jeton', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().data.email).to.eql(pm.collectionVariables.get('email'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Mon compte — sans jeton (401)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/auth/me" },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401 UNAUTHENTICATED avec WWW-Authenticate', () => {",
                  "    pm.response.to.have.status(401);",
                  "    pm.response.to.have.header('WWW-Authenticate');",
                  "    pm.expect(pm.response.json().error.code).to.eql('UNAUTHENTICATED');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
