    {
      "name": "L3 — Monde et combat",
      "item": [
        {
          "name": "Zone du personnage",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/characters/{{characterId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('zoneId', pm.response.json().data.zoneId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Monstres de la zone",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/zones/{{zoneId}}/monsters",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200, Loup / Sanglier / Bandit', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().data.map(m => m.name)).to.eql(['Loup', 'Sanglier', 'Bandit']);",
                  "});",
                  "pm.collectionVariables.set('monsterId', pm.response.json().data.find(m => m.code === 'wolf').id);",
                  "pm.collectionVariables.set('banditId', pm.response.json().data.find(m => m.code === 'bandit').id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Démarrer un combat contre le loup",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/combats",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"characterId\": \"{{characterId}}\",\n  \"monsterId\": \"{{monsterId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201, le loup (plus rapide) a joué son premier tour', () => {",
                  "    pm.response.to.have.status(201);",
                  "    const data = pm.response.json().data;",
                  "    pm.expect(data.status).to.eql('IN_PROGRESS');",
                  "    pm.expect(data.lastTurn.monsterDamage).to.eql(7);",
                  "});",
                  "pm.collectionVariables.set('combatId', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Démarrer un second combat (409)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/combats",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"characterId\": \"{{characterId}}\",\n  \"monsterId\": \"{{monsterId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('409 CHARACTER_ALREADY_IN_COMBAT', () => {",
                  "    pm.response.to.have.status(409);",
                  "    pm.expect(pm.response.json().error.code).to.eql('CHARACTER_ALREADY_IN_COMBAT');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Attaquer",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/combats/{{combatId}}/actions",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"ATTACK\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "if (data.status === 'IN_PROGRESS') {",
                  "    pm.test('rewards null tant que le combat continue', () => pm.expect(data.rewards).to.eql(null));",
                  "    // Runner : rejoue cette requête tant que le combat est en cours.",
                  "    pm.execution.setNextRequest('Attaquer');",
                  "} else {",
                  "    pm.test('VICTORY : 25 XP, niveau 1, butin éventuel (Peau de loup, quantité 1)', () => {",
                  "        pm.expect(data.status).to.eql('VICTORY');",
                  "        pm.expect(data.rewards.experienceGained).to.eql(25);",
                  "        pm.expect(data.rewards.levelsGained).to.eql(0);",
                  "        pm.expect(data.rewards.level).to.eql(1);",
                  "        pm.expect(data.rewards.experience).to.eql(25);",
                  "        if (data.rewards.item !== null) pm.expect(data.rewards.item).to.include({ code: 'wolf-pelt', quantity: 1 });",
                  "    });",
                  "    pm.collectionVariables.set('lootItemCode', data.rewards.item ? data.rewards.item.code : '');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Consulter le combat terminé",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/combats/{{combatId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200, VICTORY avec 92 PV (exemple de rules.md §8)', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const data = pm.response.json().data;",
                  "    pm.expect(data.status).to.eql('VICTORY');",
                  "    pm.expect(data.character.hp).to.eql(92);",
                  "    pm.expect(data.rewards).to.eql(null); // les récompenses ne sont renvoyées que par l'action finale",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Attaquer après la fin (422)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/combats/{{combatId}}/actions",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"ATTACK\"\n}"
