  "item": [
    {
      "name": "L1 — Socle et identité",
      "item": [
        {
          "name": "Santé du service",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 UP', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().data.status).to.eql('UP');",
                  "});",
                  "pm.test('X-Request-Id renvoyé', () => pm.response.to.have.header('X-Request-Id'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Inscription",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/register",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('email', `player.${Date.now()}.l1@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201, ni mot de passe ni hash', () => {",
                  "    pm.response.to.have.status(201);",
                  "    const data = pm.response.json().data;",
                  "    pm.expect(Object.keys(data)).to.have.members(['id', 'email', 'createdAt']);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Inscription — email déjà utilisé (409)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/register",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('409 EMAIL_ALREADY_USED', () => {",
                  "    pm.response.to.have.status(409);",
                  "    pm.expect(pm.response.json().error.code).to.eql('EMAIL_ALREADY_USED');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Connexion",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200, jeton Bearer', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().data.tokenType).to.eql('Bearer');",
                  "});",
                  "pm.collectionVariables.set('token', pm.response.json().data.accessToken);",
                  "pm.collectionVariables.set('refreshToken', pm.response.json().data.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Connexion — mauvais mot de passe (401)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"wrong-password\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401 INVALID_CREDENTIALS', () => {",
                  "    pm.response.to.have.status(401);",
                  "    pm.expect(pm.response.json().error.code).to.eql('INVALID_CREDENTIALS');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Mon compte",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/auth/me",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200, compte du jeton', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().data.email).to.eql(pm.collectionVariables.get('email'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Mon compte — sans jeton (401)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401 UNAUTHENTICATED avec WWW-Authenticate', () => {",
                  "    pm.response.to.have.status(401);",
                  "    pm.response.to.have.header('WWW-Authenticate');",
                  "    pm.expect(pm.response.json().error.code).to.eql('UNAUTHENTICATED');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "L2 — Personnages",
      "item": [
        {
          "name": "Classes (public)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/classes"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200, 3 classes triées par nom', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().data.map(c => c.name)).to.eql(['Guerrier', 'Mage', 'Voleur']);",
                  "});",
                  "pm.collectionVariables.set('classId', pm.response.json().data.find(c => c.code === 'warrior').id);",
                  "pm.collectionVariables.set('mageClassId', pm.response.json().data.find(c => c.code === 'mage').id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Créer un personnage",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/characters",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{characterName}}\",\n  \"classId\": \"{{classId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const letters = 'abcdefghijklmnopqrstuvwxyz';",
                  "let suffix = '';",
                  "for (let i = 0; i < 8; i++) suffix += letters[Math.floor(Math.random() * letters.length)];",
                  "pm.collectionVariables.set('characterName', 'Hero' + suffix);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201, niveau 1, XP 0', () => {",
                  "    pm.response.to.have.status(201);",
                  "    const data = pm.response.json().data;",
                  "    pm.expect(data.level).to.eql(1);",
                  "    pm.expect(data.experience).to.eql(0);",
                  "});",
                  "pm.collectionVariables.set('characterId', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Créer — niveau fourni par le client (400)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/characters",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cheater\",\n  \"classId\": \"{{classId}}\",\n  \"level\": 10\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 VALIDATION_ERROR', () => {",
                  "    pm.response.to.have.status(400);",
                  "    pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Mes personnages",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/characters",
            "auth": {
              "type": "bearer",
              "bearer": [
