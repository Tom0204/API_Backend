{
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm run test:db)",
      "Bash(npm run db:status)",
      "Bash(npx vitest run:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(npm install:*)",
      "Bash(npm run db:migrate:*)",
      "Bash(npx prisma migrate:*)"
    ],
    "deny": [
      "Bash(npm run db:reset:*)",
      "Bash(npx prisma migrate reset:*)",
      "Bash(docker compose down -v:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)",
      "Read(./.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x node_modules/.bin/tsc ] || exit 0; npx --no-install tsc --noEmit --pretty false 1>&2 || exit 2"
          }
        ]
      }
    ]
  }
}
